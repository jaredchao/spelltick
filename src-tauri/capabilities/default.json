{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for app windows",
  "windows": ["popup", "settings", "addword"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    }
  ]
}
